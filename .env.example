# Local: DB_DRIVER=sqlite (mặc định). Cloud: DB_DRIVER=turso + TURSO_DATABASE_URL + TURSO_AUTH_TOKEN.
DB_DRIVER=sqlite
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Bắt buộc >= 32 ký tự khi NODE_ENV=production.
APP_SECRET=
DATA_DIR=./data
PORT=3000
# Đăng nhập giả lập chỉ dùng khi phát triển; luôn tắt khi NODE_ENV=production.
DEV_LOGIN=true
# Sau reverse proxy (Railway...): TRUST_PROXY=1.
TRUST_PROXY=loopback
