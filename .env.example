# Sao chép thành .env ở thư mục gốc. Không đặt bí mật thật vào file mẫu này.
NODE_ENV=development
# PostgreSQL và Redis từ infra/compose.yaml. Cổng trên máy chủ đổi được nếu đã bị chiếm
# (chạy compose kèm --env-file .env để áp dụng): POSTGRES_PORT, REDIS_PORT.
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://arena:arena_dev_password@localhost:5432/arena?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=3100
WEB_PORT=5173
# Origin của giao diện; API chỉ nhận thao tác ghi (POST/PUT/DELETE) từ origin này
WEB_ORIGIN=http://localhost:5173
# Bật đăng nhập mẫu và thao tác mô phỏng. Chỉ được bật ở development/test; production từ chối khởi động nếu bật.
DEMO_MODE=true
WORKER_CONCURRENCY=2
# Ký cookie phiên. Bắt buộc >= 32 ký tự khi production.
SESSION_SECRET=dev-session-secret-change-me-0123456789
