# Local: leave DB_DRIVER=sqlite. Railway: DB_DRIVER=turso.
DB_DRIVER=sqlite
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
APP_SECRET=
DATA_DIR=./data
EMBEDDED_WORKER=true
MATCH_CONCURRENCY=1
BOT_SANDBOX=process
# Railway reverse proxy: set TRUST_PROXY=1 only with a single trusted proxy.
TRUST_PROXY=loopback
