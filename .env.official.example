ARENA_PROFILE=official
NODE_ENV=development
DEMO_MODE=false
DATABASE_URL=postgresql://arena:arena_dev_password@localhost:5432/arena?schema=arena_official
REDIS_URL=redis://localhost:6379/1
QUEUE_PREFIX=arena-official
API_PORT=3101
WEB_PORT=5174
WEB_ORIGIN=http://localhost:5174
SESSION_COOKIE_NAME=arena_official_session
SESSION_SECRET=GENERATE_UNIQUE_SECRET
EMAIL_ALLOWED_DOMAINS=vnu.edu.vn
MAIL_TRANSPORT=smtp
MAIL_FROM=Bot Arena <noreply@example.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
BOT_SANDBOX_MODE=docker
BOT_CONTAINER_CMD=docker
BOT_SANDBOX_IMAGE=python:3.13-slim
WORKER_CONCURRENCY=2
SIM_MOVE_DELAY_MS=150
MATCH_SELECT_SECONDS=600
# Chỉ dùng một lần qua pnpm admin:create:official, sau đó xóa mật khẩu bootstrap.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Ban tổ chức
