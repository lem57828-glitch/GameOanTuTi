// Schema ban đầu của Bot Arena (đặc tả M0 mục 13). Mỗi nhóm bảng có chủ sở hữu; module khác
// không ghi trực tiếp bảng của nhóm khác mà đi qua service công khai của module đó.
// Đổi schema: tạo migration mới (pnpm --filter @arena/api db:migrate:dev --name ...), không sửa migration đã áp dụng.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================ TV1 — accounts-teams

enum Role {
  student
  admin
}

model Account {
  id           String       @id @default(cuid())
  username     String       @unique
  email        String       @unique
  displayName  String
  role         Role         @default(student)
  status       String       @default("active") // active | disabled
  // Đăng nhập thật (TV1, sau M0). Tài khoản mẫu không có mật khẩu.
  studentId    String?      @unique
  className    String?
  faculty      String?
  emailVerifiedAt DateTime?
  sessionVersion Int @default(0)
  passwordHash String?
  isDemo       Boolean      @default(false)
  createdAt    DateTime     @default(now())
  memberships  Membership[]
}

model Team {
  joinCode     String       @unique @default(dbgenerated("upper(substr(md5((random())::text), 1, 10))"))
  id           String       @id @default(cuid())
  tournamentId String?
  name         String
  nameKey      String // tên đã chuẩn hóa để chống trùng trong giải
  captainId    String
  status       String       @default("draft") // draft | approved | locked | withdrawn
  isDemo       Boolean      @default(false)
  createdAt    DateTime     @default(now())
  tournament   Tournament?  @relation(fields: [tournamentId], references: [id])
  members      Membership[]
  botVersions  BotVersion[]
  botSelections BotStageSelection[]

  @@unique([tournamentId, nameKey])
}

model Membership {
  teamId       String
  accountId    String
  tournamentId String? // null khi đội chưa đăng ký giải
  joinedAt     DateTime @default(now())
  team         Team     @relation(fields: [teamId], references: [id])
  account      Account  @relation(fields: [accountId], references: [id])

  @@id([teamId, accountId])
  @@unique([accountId, tournamentId])
}

// ============================================================ TV2 — bots-runner

model BotVersion {
  id         String   @id @default(cuid())
  teamId     String
  version    Int
  label      String
  sourceHash String // sha256 nội dung mã đã lưu; phiên bản bất biến
  githubRepo String?
  commitSha String?
  sourcePath String?
  sourceCode String? // Toàn văn mã nguồn bot Python được lưu bất biến
  submittedById String? // ID người nộp
  duplicateOfId String? // ID của bot bị trùng lặp mã nguồn (nếu có)
  validationOwner String?
  validationLeaseUntil DateTime?
  validationLog String? // Nhật ký kiểm tra tính hợp lệ sơ bộ
  rulesetId  String
  status     String   @default("pending") // pending | valid | invalid
  isDemo     Boolean  @default(false)
  // Bot mô phỏng tin cậy của hệ thống (M0). Bot sinh viên thật: chưa nhận ở M0.
  demoPolicy String?
  createdAt  DateTime @default(now())
  team       Team     @relation(fields: [teamId], references: [id])
  testRuns   BotTestRun[]

  @@unique([teamId, version])
  @@index([sourceHash])
  @@index([status, createdAt])
}

/// TV2 - Gói việc 4: Lưu kết quả đấu thử (Practice Match) trong Sandbox
model BotTestRun {
  id             String      @id @default(cuid())
  botVersionId   String
  mySide         String      @default("blue") // blue | pink
  opponentType   String      // demo | bot
  extraType      String      @default("PAPER")
  opponentExtraType String    @default("PAPER")
  seed           Int         @default(0)
  rulesetId      String      @default("standard-32-4")
  initialBoard   Json?
  maxPlies       Int         @default(200)
  attempts       Int         @default(0)
  leaseOwner     String?
  leaseUntil     DateTime?
  updatedAt      DateTime    @updatedAt
  opponentTarget String      // random, greedy, rusher hoặc botVersionId
  status         String      @default("queued") // queued | running | succeeded | failed
  winner         String?     // blue | pink | null
  reason         String?     // goal | eliminate | repetition | max_plies | errors | crash | timeout
  plies          Int?
  piecesBlue     Int?
  piecesPink     Int?
  events         Json?       // Mảng GameEvent[] bàn giao TV4 replay
  error          String?
  logs           String?
  createdAt      DateTime    @default(now())
  finishedAt     DateTime?
  botVersion     BotVersion  @relation(fields: [botVersionId], references: [id])
  @@index([status, updatedAt])
}

model BotStageSelection {
  teamId String
  stageId String
  team Team @relation(fields: [teamId], references: [id])
  stage Stage @relation(fields: [stageId], references: [id])
  botVersionIds String[]
  locked Boolean @default(false)
  freezeAt DateTime?
  updatedAt DateTime @updatedAt
  @@id([teamId, stageId])
}

/// Một job logic cho mỗi requestKey. RunAttempt là từng lần thực thi (retry).
model GameJob {
  id         String       @id @default(cuid())
  requestKey String       @unique
  gameId     String       @unique
  roomId     String
  payload    Json // GameRequest đã kiểm tra
  status     String       @default("queued") // queued | dispatched | running | succeeded | failed
  attempts   Int          @default(0)
  leaseOwner String?
  leaseUntil DateTime?
  lastError  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  runs       RunAttempt[]
}

model RunAttempt {
  id         String    @id @default(cuid())
  jobId      String
  attemptNo  Int
  workerId   String
  status     String    @default("running") // running | succeeded | failed | superseded
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  error      String?
  job        GameJob   @relation(fields: [jobId], references: [id])

  @@unique([jobId, attemptNo])
  diagnostics String?
}

// ============================================================ TV3 — tournaments
// Bảng xếp hạng (Standing) tính lại từ Pairing đã có kết quả, không lưu bản sao có thể lệch.

model Tournament {
  id                   String    @id @default(cuid())
  name                 String
  status               String    @default("draft") // draft | registration | running | finished
  isDemo               Boolean   @default(false)
  description          String    @default("")
  configStatus         String    @default("draft")
  revision             Int       @default(0)
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  teamLockAt           DateTime?
  botLockAt            DateTime?
  /// Phạm vi tránh tái đấu Swiss: level (trong một mức) | qualifier (toàn bộ sơ loại). Q03 chờ BTC chốt.
  avoidRematch         String    @default("level")
  /// Danh sách 4 đội vào bán kết sau khi chốt tứ kết (JSON mảng teamId).
  top4                 Json?
  createdAt            DateTime  @default(now())
  stages               Stage[]
  teams                Team[]
  levels               QualifierLevel[]
  pairings             Pairing[]
  bracketRounds        BracketRound[]
}

model Stage {
  id           String     @id @default(cuid())
  tournamentId String
  ord          Int
  kind         String // qualifier | knockout
  name         String
  status       String     @default("planned")
  configStatus String     @default("draft")
  startsAt     DateTime?
  endsAt       DateTime?
  lockAt       DateTime?
  tournament   Tournament @relation(fields: [tournamentId], references: [id])

  botSelections BotStageSelection[]

  @@unique([tournamentId, ord])
}

/// Một mức sơ loại (ví dụ 1000 → 500 → 200 → 100 → 32). Swiss chạy trong từng mức; điểm đặt lại khi sang mức mới.
model QualifierLevel {
  id           String     @id @default(cuid())
  tournamentId String
  ord          Int
  name         String
  teamTarget   Int
  rounds       Int
  status       String     @default("planned") // planned | locked | running | cutting | done | skipped
  seed         Int?
  teamsIn      Int?
  /// Đội tham gia mức (JSON mảng teamId), chốt khi khóa mức.
  entrants     Json?
  /// Trạng thái tranh suất ở ranh giới cắt (JSON).
  cutState     Json?
  /// Đội đi tiếp sau khi chốt mức (JSON mảng teamId, theo thứ hạng).
  qualified    Json?
  botLockAt    DateTime?
  publishAt    DateTime?
  lockedAt     DateTime?
  finishedAt   DateTime?
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  pairings     Pairing[]
  bots         LevelBot[]

  @@unique([tournamentId, ord])
}

/// Bot một đội dùng cho MỌI trận Swiss/tranh suất của một mức sơ loại. Đội trưởng chọn tới khi mức khóa;
/// khóa mức thì chốt (đội chưa chọn: bot của mức trước, không có thì bot hợp lệ mới nhất — auto = true).
model LevelBot {
  levelId      String
  teamId       String
  botVersionId String?
  auto         Boolean        @default(false)
  chosenById   String?
  updatedAt    DateTime       @default(now()) @updatedAt
  level        QualifierLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@id([levelId, teamId])
}

/// Vòng loại trực tiếp của cây 32 → 4: r32 | r16 | qf.
model BracketRound {
  id           String     @id @default(cuid())
  tournamentId String
  phase        String
  ord          Int
  status       String     @default("pending") // pending | running | finished | done
  startedAt    DateTime?
  confirmedAt  DateTime?
  tournament   Tournament @relation(fields: [tournamentId], references: [id])

  @@unique([tournamentId, phase])
}

/// Cặp đấu do TV3 tạo (PairAssignment). TV4 mở trận theo cặp và trả MatchCompleted; TV3 chốt chính thức.
model Pairing {
  id            String          @id @default(cuid())
  tournamentId  String
  kind          String // swiss | bye | tiebreak | knockout
  levelId       String?
  round         Int // vòng Swiss; bước tranh suất (1000 + bước); số thứ tự vòng loại trực tiếp
  phase         String? // r32 | r16 | qf
  slot          Int?
  teamAId       String?
  teamBId       String?
  seedA         Int?
  seedB         Int?
  status        String          @default("scheduled") // scheduled | done | cancelled
  seed          Int
  result        String? // a | b | draw
  winnerTeamId  String?
  scoreA        Int             @default(0)
  scoreB        Int             @default(0)
  /// Kết quả từng ván/hiệp (JSON) để đối soát.
  games         Json?
  decidedBy     String? // score | extra | lots | bye | walkover
  source        String? // simulation | manual | match
  resultVersion Int             @default(0)
  confirmed     Boolean         @default(false)
  matchId       String? // Match của TV4 khi đã nối phòng đấu
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  tournament    Tournament      @relation(fields: [tournamentId], references: [id])
  level         QualifierLevel? @relation(fields: [levelId], references: [id])
  appeals       Appeal[]

  @@index([tournamentId, kind, levelId, round])
  @@index([tournamentId, phase])
}

/// Khiếu nại chính thức của đội trưởng về một cặp đấu chưa chốt. Khiếu nại mở chặn việc chốt vòng/mức.
model Appeal {
  id          String    @id @default(cuid())
  pairingId   String
  teamId      String
  accountId   String
  gameNo      Int?
  moveNo      Int?
  body        String
  evidence    String?
  status      String    @default("open") // open | accepted | rejected
  action      String? // none | rerun
  decision    String?
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  pairing     Pairing   @relation(fields: [pairingId], references: [id])

  @@index([status])
}

// ============================================================ TV4 — rooms-matches

model Room {
  id            String   @id @default(cuid())
  code          String   @unique
  title         String
  isDemo        Boolean  @default(false)
  status        String   @default("idle") // idle | waiting | running | finished | failed
  teamAId       String
  teamBId       String
  currentGameId String?
  /// Phòng của một cặp đấu TV3 (dùng xuyên suốt các hiệp, hiệp phụ và lần chạy lại). null = phòng mẫu.
  pairingId     String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  matches       Match[]
}

model Match {
  id          String           @id @default(cuid())
  roomId      String
  pairId      String? // Pairing của TV3
  /// open (trận demo 1 ván) | selecting | running | paused | completed | cancelled
  status      String           @default("open")
  kind        String           @default("demo") // demo | swiss | tiebreak | knockout
  stageId     String?
  teamAId     String?
  teamBId     String?
  scoreA      Int              @default(0)
  scoreB      Int              @default(0)
  /// Kết quả từng ván/hiệp theo góc nhìn đội A: "a" | "b" | null (hòa).
  outcomes    Json?
  /// Số thứ tự hiệp đang chọn/đang chạy (1-based).
  currentNo   Int              @default(0)
  deadlineAt  DateTime?
  pauseReason String?
  completedAt DateTime?
  /// Đã gửi kết quả trận cho TV3 (recordResult). null + completed = cần gửi bù (vd. tiến trình dừng giữa chừng).
  reportedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  room        Room             @relation(fields: [roomId], references: [id])
  games       Game[]
  selections  MatchSelection[]

  @@index([status])
}

/// Lựa chọn kín của một đội cho một hiệp: bot trong bộ đã khóa và loại quân thứ 10.
/// Không công bố cho khán giả/đối thủ trước khi khóa; khóa rồi thì không đổi.
model MatchSelection {
  matchId      String
  gameNo       Int
  teamId       String
  botVersionId String
  extraType    String   @default("PAPER")
  ready        Boolean  @default(false)
  /// Do hệ thống chọn khi hết giờ (đề xuất Q08: dùng lại lựa chọn hiệp trước).
  auto         Boolean  @default(false)
  updatedAt    DateTime @default(now()) @updatedAt
  match        Match    @relation(fields: [matchId], references: [id])

  @@id([matchId, gameNo, teamId])
}

model Game {
  id         String       @id @default(cuid())
  matchId    String
  roomId     String
  no         Int
  rulesetId  String
  seed       Int
  maxPlies   Int
  status     String       @default("queued") // queued | running | finished | failed
  // Do máy chủ quyết định một lần, lưu trước khi chạy; tải lại chỉ đọc lại giá trị đã lưu.
  coinResult Json?
  blueTeamId String?
  pinkTeamId String?
  lastSeq    Int          @default(0) // seq cuối của stream sự kiện của ván
  createdAt  DateTime     @default(now())
  finishedAt DateTime?
  match      Match        @relation(fields: [matchId], references: [id])
  choices    GameChoice[]
  result     GameResult?
  events     GameEvent[]

  @@unique([matchId, no])
}

/// Lựa chọn đã khóa của mỗi bên trước khi chạy; retry dùng lại đúng lựa chọn này.
model GameChoice {
  gameId       String
  side         String // blue | pink
  teamId       String
  botVersionId String
  extraType    String?
  lockedAt     DateTime @default(now())
  game         Game     @relation(fields: [gameId], references: [id])

  @@id([gameId, side])
}

/// Kết quả có hiệu lực: tối đa MỘT bản ghi cho mỗi ván.
model GameResult {
  id            String   @id @default(cuid())
  gameId        String   @unique
  attemptId     String
  requestKey    String
  winner        String? // blue | pink | null = hòa
  winnerTeamId  String?
  reason        String
  plies         Int
  piecesBlue    Int
  piecesPink    Int
  rulesetId     String
  resultVersion Int      @default(1)
  createdAt     DateTime @default(now())
  game          Game     @relation(fields: [gameId], references: [id])
}

/// Sự kiện có thứ tự của một ván (stream "game:<gameId>"). Nước đi là duy nhất theo (gameId, ply)
/// nên một lần chạy lại theo cùng seed không ghi trùng.
model GameEvent {
  id         String   @id @default(cuid())
  gameId     String
  streamId   String
  seq        Int
  type       String
  ply        Int?
  payload    Json
  occurredAt DateTime @default(now())
  game       Game     @relation(fields: [gameId], references: [id])

  @@unique([streamId, seq])
  @@unique([gameId, type, ply])
}

// ============================================================ Dùng chung

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String?
  reason    String?
  data      Json?
  requestId String?
  createdAt DateTime @default(now())
}

/// Sự kiện chờ phát sang hàng đợi/tiến trình khác; ghi cùng transaction với thay đổi dữ liệu.
model OutboxEvent {
  id           String    @id @default(cuid())
  type         String
  aggregateId  String
  payload      Json
  status       String    @default("pending") // pending | dispatched
  attempts     Int       @default(0)
  availableAt  DateTime  @default(now())
  lastError    String?
  createdAt    DateTime  @default(now())
  dispatchedAt DateTime?

  @@index([status, availableAt])
}

model AuthToken {
  id String @id @default(cuid())
  accountId String
  kind String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([accountId, kind])
}

model TeamInvitation {
  id String @id @default(cuid())
  teamId String
  email String
  invitedBy String
  status String @default("pending")
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@unique([teamId, email])
  @@index([email, status])
}

model Notification {
  id String @id @default(cuid())
  accountId String
  sourceKey String
  title String
  body String
  href String?
  readAt DateTime?
  createdAt DateTime @default(now())
  @@unique([accountId, sourceKey])
  @@index([accountId, createdAt])
}

model EmailMessage {
  id String @id @default(cuid())
  to String
  subject String
  text String
  dedupeKey String @unique
  status String @default("pending")
  attempts Int @default(0)
  lastError String?
  availableAt DateTime @default(now())
  sentAt DateTime?
  createdAt DateTime @default(now())
  @@index([status, availableAt])
}

model Publication {
  id String @id @default(cuid())
  title String
  body String
  kind String @default("announcement")
  linkUrl String?
  published Boolean @default(false)
  authorId String
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationCursor {
  name String @id
  at DateTime
  lastId String @default("")
}

model RegistrationCode {
  email String @id
  codeHash String
  nonce String
  attempts Int @default(0)
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
}
