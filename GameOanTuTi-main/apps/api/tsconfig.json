{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "rootDir": ".",
    "noEmit": true,
    "types": ["node"],
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src", "test", "prisma/*.ts"]
}
