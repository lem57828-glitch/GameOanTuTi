{
  "name": "bot-arena",
  "private": true,
  "version": "0.1.0",
  "description": "Bot Arena — website thi bot cờ búa kéo bao (nền M0)",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "env:init": "node scripts/init-profiles.mjs",
    "dev:demo": "node scripts/runtime.mjs demo dev",
    "dev:official": "node scripts/runtime.mjs official dev",
    "tunnel:demo": "node scripts/tunnel-demo.mjs",
    "worker:demo": "node scripts/runtime.mjs demo worker",
    "worker:official": "node scripts/runtime.mjs official worker",
    "start:official": "node scripts/runtime.mjs official start",
    "db:migrate:demo": "node scripts/runtime.mjs demo migrate",
    "db:migrate:official": "node scripts/runtime.mjs official migrate",
    "db:seed:demo": "node scripts/runtime.mjs demo seed",
    "demo:experience": "node scripts/runtime.mjs demo experience",
    "admin:create:official": "node scripts/runtime.mjs official bootstrap-admin",
    "test:profiles": "node --test scripts/runtime-profile.test.mjs",
    "dev": "pnpm --filter @arena/game-engine... build && pnpm --parallel --filter @arena/api --filter @arena/web dev",
    "dev:worker": "pnpm --filter @arena/worker dev",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @arena/api db:generate",
    "db:migrate": "pnpm --filter @arena/api db:migrate",
    "db:seed": "pnpm --filter @arena/game-engine... build && pnpm --filter @arena/api db:seed",
    "db:reset": "pnpm --filter @arena/api db:reset",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @arena/api test:integration",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "tv2:acceptance": "node scripts/tv2-acceptance.mjs",
    "test:features": "node scripts/test-features.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@playwright/test": "1.50.1",
    "eslint": "9.19.0",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "typescript": "5.8.2",
    "typescript-eslint": "8.26.1"
  }
}
